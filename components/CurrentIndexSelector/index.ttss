/* 遮罩层和容器 */
.init {
  width: 100%;
  min-height: 100%;
  position: fixed;
  z-index: 1002;
  right: 0;
  left: 0;
  bottom: 0;
}

.init .mask {
  width: 100%;
  height: 100%;
  position: absolute;
  z-index: 1003;
  top: 0;
  right: 0;
  left: 0;
  bottom: 0;
  background: rgba(0, 0, 0, 0.5);
  backdrop-filter: blur(4px);
}

/* 动画 */
.animatedShow {
  animation: fadeIn 0.2s ease-out forwards;
}

@keyframes fadeIn {
  0% { opacity: 0; }
  100% { opacity: 1; }
}

.animatedHide {
  animation: fadeOut 0.2s ease-out forwards;
}

@keyframes fadeOut {
  0% { opacity: 1; }
  100% { opacity: 0; }
}

.DrawerContainerShow {
  animation: slideUp 0.3s cubic-bezier(0.16, 1, 0.3, 1) forwards;
}

@keyframes slideUp {
  0% { transform: translateY(100%); }
  100% { transform: translateY(0); }
}

.DrawerContainerHide {
  animation: slideDown 0.3s cubic-bezier(0.16, 1, 0.3, 1) forwards;
}

@keyframes slideDown {
  0% { transform: translateY(0); }
  100% { transform: translateY(100%); }
}

/* 弹窗容器 */
.init .wrap {
  position: absolute;
  display: flex;
  flex-direction: column;
  width: 100%;
  height: 65%;
  bottom: 0;
  background: linear-gradient(180deg, #ffffff 0%, #f8fafc 100%);
  border-radius: 24px 24px 0 0;
  z-index: 1004;
  box-shadow: 0 -10px 40px rgba(0, 0, 0, 0.1);
  overflow: hidden;
}

/* 顶部标题栏 */
.header-bar {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 20rpx 32rpx;
  background: #ffffff;
  border-bottom: 1rpx solid #f1f5f9;
}

.header-title {
  font-size: 36rpx;
  font-weight: 600;
  color: #1e293b;
}

.header-right {
  display: flex;
  align-items: center;
  gap: 24rpx;
}

.stats {
  display: flex;
  gap: 20rpx;
}

.stat-item {
  display: flex;
  align-items: center;
  gap: 8rpx;
  font-size: 24rpx;
  color: #64748b;
}

.stat-dot {
  width: 16rpx;
  height: 16rpx;
  border-radius: 50%;
}

.stat-item.right .stat-dot {
  background: linear-gradient(135deg, #22c55e 0%, #16a34a 100%);
}

.stat-item.wrong .stat-dot {
  background: linear-gradient(135deg, #f87171 0%, #ef4444 100%);
}

.confirm-btn {
  padding: 16rpx 32rpx;
  background: linear-gradient(135deg, #3b82f6 0%, #2563eb 100%);
  border-radius: 40rpx;
  box-shadow: 0 4rpx 12rpx rgba(59, 130, 246, 0.3);
}

.confirm-btn text {
  font-size: 28rpx;
  font-weight: 500;
  color: #ffffff;
}

.confirm-btn:active {
  transform: scale(0.96);
  box-shadow: 0 2rpx 8rpx rgba(59, 130, 246, 0.3);
}

/* 内容区域 */
.content {
  flex: 1;
  height: 100%;
  padding: 24rpx;
  box-sizing: border-box;
}

.grid-container {
  display: flex;
  flex-wrap: wrap;
  gap: 12rpx;
  padding-bottom: 100rpx;
  justify-content: center;
}

/* 题号格子 - Claymorphism 风格 */
.number-item {
  width: calc((100% - 88rpx) / 9);
  aspect-ratio: 1;
  display: flex;
  align-items: center;
  justify-content: center;
  border-radius: 12rpx;
  background: #ffffff;
  box-shadow:
    0 1rpx 2rpx rgba(0, 0, 0, 0.02),
    0 2rpx 4rpx rgba(0, 0, 0, 0.04),
    inset 0 1rpx 1rpx rgba(255, 255, 255, 0.8);
  border: 2rpx solid #e2e8f0;
  transition: all 0.2s ease;
}

.number-item text {
  font-size: 26rpx;
  font-weight: 500;
  color: #475569;
}

.number-item:active {
  transform: scale(0.94);
}

/* 当前选中状态 */
.number-item.active {
  background: linear-gradient(135deg, #3b82f6 0%, #2563eb 100%);
  border-color: #2563eb;
  box-shadow:
    0 2rpx 8rpx rgba(59, 130, 246, 0.4),
    0 4rpx 12rpx rgba(59, 130, 246, 0.2),
    inset 0 1rpx 1rpx rgba(255, 255, 255, 0.3);
}

.number-item.active text {
  color: #ffffff;
  font-weight: 600;
}

/* 正确状态 */
.number-item.right {
  background: linear-gradient(135deg, #dcfce7 0%, #bbf7d0 100%);
  border-color: #86efac;
}

.number-item.right text {
  color: #166534;
}

.number-item.right.active {
  background: linear-gradient(135deg, #22c55e 0%, #16a34a 100%);
  border-color: #16a34a;
  box-shadow:
    0 2rpx 8rpx rgba(34, 197, 94, 0.4),
    0 4rpx 12rpx rgba(34, 197, 94, 0.2),
    inset 0 1rpx 1rpx rgba(255, 255, 255, 0.3);
}

.number-item.right.active text {
  color: #ffffff;
}

/* 错误状态 */
.number-item.wrong {
  background: linear-gradient(135deg, #fee2e2 0%, #fecaca 100%);
  border-color: #fca5a5;
}

.number-item.wrong text {
  color: #991b1b;
}

.number-item.wrong.active {
  background: linear-gradient(135deg, #f87171 0%, #ef4444 100%);
  border-color: #ef4444;
  box-shadow:
    0 2rpx 8rpx rgba(239, 68, 68, 0.4),
    0 4rpx 12rpx rgba(239, 68, 68, 0.2),
    inset 0 1rpx 1rpx rgba(255, 255, 255, 0.3);
}

.number-item.wrong.active text {
  color: #ffffff;
}
